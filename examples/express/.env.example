# Server Configuration
PORT=3001
DEBUG=true
SERVER_URL=http://localhost:3001

# Security Configuration
API_KEYS=test-key-1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_METHODS=GET,POST,PUT,DELETE
API_KEY_HEADER=X-API-Key

# PayPal Sandbox Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENVIRONMENT=sandbox

# Nexi Sandbox Configuration
NEXI_MERCHANT_ID=your_nexi_merchant_id
NEXI_MAC_KEY=your_nexi_mac_key
NEXI_GROUP=your_nexi_group
NEXI_ENVIRONMENT=sandbox

# Satispay Sandbox Configuration
SATISPAY_KEY_ID=your_satispay_key_id
SATISPAY_ENVIRONMENT=sandbox
SATISPAY_WEBHOOK_PUBLIC_KEY=
