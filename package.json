{
  "name": "awesome-node-checkout",
  "version": "1.2.2",
  "description": "Framework-agnostic payment checkout library for Node.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express/index.d.ts",
      "default": "./dist/adapters/express/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "payment",
    "checkout",
    "paypal",
    "nexi",
    "satispay",
    "stripe",
    "node",
    "typescript",
    "framework-agnostic"
  ],
  "author": "Nicola Brecciaroli <nicola.brecciaroli@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/nik2208/awesome-node-checkout.git"
  },
  "bugs": {
    "url": "https://github.com/nik2208/awesome-node-checkout/issues"
  },
  "homepage": "https://github.com/nik2208/awesome-node-checkout#readme",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "express": "^5.0.0",
    "supertest": "^7.2.2",
    "typescript": "^5.8.0",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@paypal/paypal-server-sdk": "^2.2.0"
  }
}
